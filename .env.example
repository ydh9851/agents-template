# ============ 复制为 .env 后再填写，切勿把真实 Key 提交到 git ============

# ---------- LLM（DeepSeek，OpenAI 兼容协议） ----------
# 留空则自动进入 Mock 模式：整条链路仍可跑通，但输出为占位内容
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-chat
TEMPERATURE=0.2
# 强制离线 Mock（true / false）
MOCK_LLM=false
# Mock 模式下让 Checker 前 N 次判不通过，用于离线验证「打回重做」分支（0 = 不打回）
MOCK_CHECKER_FAIL_TIMES=0

# ---------- LLM 可靠性 ----------
# 单次调用失败后的重试次数（不含首次）
LLM_MAX_RETRIES=2
# 重试退避基数（秒）：第 n 次重试等待 base * 2^(n-1)
LLM_RETRY_BACKOFF=0.8
# 整个调用（含所有重试）的总时间预算（秒），防止一次请求把节点占死
LLM_TOTAL_TIMEOUT=120
# 主模型失败后的备用模型，逗号分隔（如 deepseek-reasoner），留空表示不回退
FALLBACK_MODELS=
# 单个任务的 token 预算，超出一律不再调用真实模型（0 = 不限制）
TASK_TOKEN_BUDGET=0

# ---------- 可观测性 ----------
# text = 人读友好（默认）；json = 一行一个 JSON，便于日志采集
LOG_FORMAT=text

# ---------- 安全 ----------
# 逗号分隔的 API Key；留空表示不开启鉴权（保持 clone 下来就能跑）
API_KEYS=
# 每个客户端的每分钟请求上限（0 = 不限制）
RATE_LIMIT_PER_MINUTE=0
# 限流后端：memory = 单进程内存（默认，零依赖）；redis = 多副本共享计数
RATE_LIMIT_BACKEND=memory
REDIS_URL=redis://localhost:6379/0
# 是否信任反向代理传来的 X-Forwarded-For（本地直连时保持 false，否则限流可被伪造头绕过）
TRUST_PROXY=false

# ---------- 混合检索 RAG ----------
DOCS_DIR=data/docs
CHUNK_SIZE=500
CHUNK_OVERLAP=80
RAG_TOP_K=3
RRF_K=60

# ---------- Rerank（RRF 融合之后的精排）----------
# none / heuristic（默认，零依赖）/ cross_encoder（需 sentence-transformers）/ llm
RERANK_PROVIDER=heuristic
# 送入重排的候选数：先取这么多，再精排到 RAG_TOP_K
RERANK_POOL=10
RERANK_MODEL=BAAI/bge-reranker-base

# ---------- 工具与工作区 ----------
# Worker 能调用的工具（逗号分隔）；留空表示不开放，退化为纯文本产出
WORKER_TOOLS=list_files,read_file,write_file,run_python,run_tests
# 单个子任务最多几轮工具调用；用尽后会摘掉工具让它收尾
MAX_TOOL_ROUNDS=3
# 单个产物文件大小上限（KB）
ARTIFACT_MAX_KB=256
# 工作区目录：所有文件读写都被限制在这个目录内
WORKSPACE_DIR=data/workspace

# ---------- 代码沙箱 ----------
# subprocess = 子进程执行（默认，零依赖，但**不是隔离**：与宿主同用户、能联网）
# docker     = 容器隔离（--network=none + 内存/PID 上限），要跑不可信代码必须用这个
SANDBOX_BACKEND=subprocess
# 单次执行超时（秒）；超时会杀掉整个进程组
SANDBOX_TIMEOUT=20
SANDBOX_MAX_MEMORY_MB=256
SANDBOX_DOCKER_IMAGE=python:3.11-slim
# 子进程输出保留的最大字符数（超出只保留尾部）
SANDBOX_OUTPUT_LIMIT=4000

# ---------- 编码任务（Coder / Tester）----------
# 关掉后摘除执行类工具，整体退化为「写文件 + 文本产出」
CODE_EXECUTION_ENABLED=true
# Coder / Tester 各自的工具轮次上限
CODING_MAX_ROUNDS=6
TESTING_MAX_ROUNDS=2

# local = 零依赖本地哈希向量（默认，开箱即用）
# openai = 调用任意 OpenAI 兼容的 embedding 接口（DeepSeek 官方暂无 embedding，需自行指定服务）
EMBEDDING_PROVIDER=local
EMBEDDING_DIM=384
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# ---------- 编排 ----------
SQLITE_PATH=data/checkpoint.sqlite
MAX_SUBTASKS=5
MAX_RETRY_PER_SUBTASK=2
# 同一层就绪子任务的并行执行上限（LLM 调用是 IO 密集型，并发能显著缩短总耗时）
MAX_PARALLEL_SUBTASKS=3

# ---------- 服务 ----------
HOST=0.0.0.0
PORT=8000
# 生产环境请改成具体域名，例如 https://your-domain.com
CORS_ORIGINS=*
